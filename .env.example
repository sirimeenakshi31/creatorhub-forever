# ============================================================
# CreatorHub by Siri — Environment Variables (local development)
# ============================================================
# Copy this file to `.env` and fill in the values.
#
# REQUIRED for authentication (sign in / sign up / sessions).
# Without these, the app shows "Sign in is temporarily unavailable".
#
# Get these from Lovable → Cloud → Backend, or from your Supabase
# project dashboard → Project Settings → API.
# ============================================================

# --- Supabase / Lovable Cloud (REQUIRED for auth) ---
# Client-side (Vite exposes any VITE_* var to the browser).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-ANON-KEY
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Server-side fallbacks (used during SSR / server functions).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-ANON-KEY
# Service role key — server-only, NEVER expose to the browser, NEVER prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ============================================================
# OPTIONAL — AI / media tools. App falls back to mock outputs
# when these are missing, so every tool stays usable.
# ============================================================

# --- Lovable AI Gateway (powers /api/ai/text and /api/ai/image) ---
LOVABLE_API_KEY=

# --- ElevenLabs (powers /api/audio TTS and /api/transcribe STT) ---
ELEVENLABS_API_KEY=

# --- Replicate (powers /api/replicate/run, /api/video, /api/face-swap) ---
REPLICATE_API_TOKEN=

# --- Optional: OpenAI ---
OPENAI_API_KEY=
